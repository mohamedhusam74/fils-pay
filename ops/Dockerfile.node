# Image for api, reporting, migrate and seed. Build context is the repo root
# (see docker-compose.yml). Every service runs TypeScript directly through
# tsx, so this is a full workspace install (devDependencies included), not a
# compiled production build.
#
# Node 22 rather than 20: cookie@2 (pulled in by @fastify/cookie) declares
# engines.node >=22.
FROM node:22-bookworm-slim

WORKDIR /app

# Manifests first so the npm ci layer is cached until dependencies change.
# npm ci needs every workspace's package.json to match package-lock.json.
COPY package.json package-lock.json ./
COPY apps/admin/package.json apps/admin/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY packages/events/package.json packages/events/
COPY packages/money/package.json packages/money/
RUN npm ci --no-audit --no-fund

COPY . .

# apps/api writes KYC uploads under ./data/kyc (KYC_UPLOAD_DIR default).
RUN mkdir -p data/kyc && chown -R node:node data
USER node
